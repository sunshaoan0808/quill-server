# Copy to .env and fill secrets. Do not commit .env.
# [refactor 2026-09-27] 统一为 KALEIDO_* 命名；旧 MUSEAI_* 变量仍被
# seed_legacy_env_aliases() 兼容读取，但新部署请用新名。

KALEIDO_HOST=0.0.0.0
KALEIDO_PORT=18766
KALEIDO_DATA=/data

# Bootstrap admin (only used when $KALEIDO_DATA/state/users.json is empty)
KALEIDO_ADMIN_USER=admin
KALEIDO_ADMIN_PASSWORD=change-me-strong-password

# Session / rate limits
KALEIDO_SESSION_TTL_HOURS=12
KALEIDO_LOGIN_MAX_ATTEMPTS=10
KALEIDO_LOGIN_WINDOW_SECS=300
KALEIDO_MAX_SESSIONS=50
KALEIDO_MAX_CONCURRENT_JOBS=2

# 可选：受信反向代理网段（逗号分隔 IP 或 CIDR，如 172.18.0.0/16,::1）。
# 仅当直连对端在此列表内时，登录限流才采信 X-Forwarded-For；不配置（默认，
# 直连部署）一律用真实对端 IP，防止轮换伪造 XFF 绕过 KALEIDO_LOGIN_MAX_ATTEMPTS。
# KALEIDO_TRUSTED_PROXIES=

# OpenAI-compatible LLM (AxonHub / NewAPI / etc.)
LLM_BASE_URL=http://host.docker.internal:8090/v1
LLM_API_KEY=ah-xxxxxxxx
LLM_MODEL=deepseek-v4-flash
# provider 协议：openai(默认) / anthropic / google
KALEIDO_LLM_PROVIDER=openai

# Embedding：内联 fastembed（默认开）优先，失败回落 HTTP /v1/embeddings，再回落 hash 兜底
# [2026-10-04] 模型自举：本地缺 BGE-zh 模型文件时，启动 warm 路径会自动从 HF 下载一次
# （~90MB，落 $KALEIDO_EMBED_CACHE/bge-small-zh-v1.5/；离线/失败仅降级远端，不阻断启动）。
# KALEIDO_EMBED_INLINE=1
# KALEIDO_EMBED_CACHE=/data/embed-cache
# KALEIDO_EMBED_MODEL_DIR=/path/to/bge-small-zh-v1.5   # 显式指定 onnx 快照目录
# KALEIDO_EMBED_AUTODL=1                               # 置 0 关闭首启自动下载
# KALEIDO_HF_ENDPOINT=https://hf-mirror.com            # HF 镜像（国内部署建议）
# EMBEDDING_BASE_URL=http://127.0.0.1:20145            # 远程 embedding 代理（可选）

# Web 静态资源目录（容器内已由镜像自带 /app/web；本机部署可不填，自动探测）
# KALEIDO_WEB_DIR=/app/web

# 可选：edge-tts CLI 绝对路径（不设则按 PATH/常规位置探测）
# KALEIDO_EDGE_TTS_BIN=/usr/local/bin/edge-tts

RUST_LOG=kaleido_server=info,kaleido_core=info

# SD WebUI (A1111) 本地生图（channel=a1111 时使用；留空则默认 http://127.0.0.1:7860）
A1111_BASE_URL=http://127.0.0.1:7860
